# Variáveis do painel (Next.js). Copie para ".env.local" para rodar localmente
# (npm run dev) ou defina os mesmos nomes como "vars"/"secrets" do repositório
# no GitHub Actions para o build de deploy (.github/workflows/deploy-pages.yml).
#
# Todas são PÚBLICAS: o painel é estático (output: "export") e roda inteiro no
# navegador, então nada aqui pode ser segredo — a proteção dos dados fica por
# conta do RLS do Supabase e do login (cadastro público desativado).

# URL do projeto Supabase (Project Settings > Data API).
# Ex.: https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave "anon" (pública) do projeto Supabase (Project Settings > API Keys).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sub-caminho onde o painel é publicado no GitHub Pages, no formato
# "/nome-do-repositorio" (sem barra no final). Deixe em branco para rodar na
# raiz (ex.: domínio próprio ou "usuario.github.io"). O workflow de deploy
# preenche isso automaticamente com "/${{ github.event.repository.name }}".
NEXT_PUBLIC_BASE_PATH=
