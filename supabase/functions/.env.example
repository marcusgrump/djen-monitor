# Segredos da Edge Function "djen-sync". Não use "supabase start" com este
# arquivo em produção — defina os valores reais com:
#   npx supabase secrets set --env-file supabase/functions/.env
# (crie sua própria cópia local ".env", nunca commitada; veja .gitignore)
#
# Em produção, GMAIL_USER/GMAIL_APP_PASSWORD/EMAIL_FROM_NAME/CRON_SECRET ficam
# como secrets da função (comando acima ou o workflow supabase-deploy.yml).
# project_url e cron_secret usados pelo pg_cron/pg_net ficam no Vault do
# Supabase (segredos do banco, não da função) — veja o passo 5 do README.

# Endereço Gmail usado para autenticar no SMTP (smtp.gmail.com:465) e como
# remetente das notificações.
GMAIL_USER=

# Senha de App do Gmail (NÃO é a senha normal da conta). Gere em
# https://myaccount.google.com/apppasswords — exige verificação em 2 etapas
# ativada na conta.
GMAIL_APP_PASSWORD=

# Nome de exibição do remetente nos e-mails (opcional).
# Ex.: "DJEN Monitor"
EMAIL_FROM_NAME=

# Segredo compartilhado que autoriza a chamada do pg_cron (via pg_net) à
# função: sem ele (no cabeçalho "x-cron-secret") a função só aceita o JWT de
# um usuário logado no painel. Gere um valor aleatório longo, por exemplo com:
#   node -e "console.log(require('crypto').randomUUID())"
# O MESMO valor deve ser salvo no Vault do Supabase como "cron_secret"
# (usado pela migration supabase/migrations/20260928204455_cron.sql).
CRON_SECRET=

# Opcionais:
# Orçamento de tempo total da execução em ms (padrão 110000; a busca para
# ~25 s antes para sobrar tempo ao banco e ao e-mail). Plano Free: parede de 150 s.
# SYNC_ORCAMENTO_MS=110000
# User-Agent enviado à API do DJEN (padrão "DJEN-Monitor/1.0 (...)").
# DJEN_USER_AGENT=
